{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mdc-website",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "observability": { "enabled": true }
}
